# Normalise line endings so the repo behaves the same on Windows and in CI.
* text=auto eol=lf

# Windows scripts must keep CRLF or cmd.exe can misread them.
*.bat text eol=crlf
*.cmd text eol=crlf

# The Unix wrapper script must keep LF.
gradlew text eol=lf

# Binary files.
*.jar binary
*.png binary
*.gif binary
